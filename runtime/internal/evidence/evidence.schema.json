{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes-devops/contracts/evidence.schema.json",
  "title": "evidence.json v3",
  "description": "Runtime Evidence Extractor 的确定性产出(CLAUDE.md §12 Phase 2):单遍流式扫描完整日志并保留签名命中处 ±50 行上下文、全局行号、有界兜底摘录、junit 失败和指标快照。普通大文件不再受 8MiB 尾部窗口限制;超过 1MiB 的单行会降级截断扫描。签名上下文与兜底摘录共享 96KiB 内容预算;该预算不等同于整个序列化 evidence.json 的硬上限。evidence.json 是 Analyzer(LLM)的唯一输入——严禁把原始日志全量灌入 LLM。本契约对未知字段宽容,已知字段严格校验。",
  "type": "object",
  "required": ["evidence_version", "task_id", "variant", "status", "exit_code", "cases", "signatures", "junit_failures", "inputs"],
  "properties": {
    "evidence_version": { "const": 3 },
    "task_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "variant": { "type": "string", "minLength": 1 },
    "status": {
      "description": "Client 侧终态(§9)",
      "enum": ["COMPLETED", "FAILED", "TIMEOUT", "CANCELED"]
    },
    "exit_code": { "type": "integer" },
    "duration_sec": { "type": "number", "minimum": 0 },
    "cases": {
      "type": "object",
      "required": ["total", "passed", "failed", "skipped"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 }
      }
    },
    "signatures_hit_reported": {
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "description": "设备脚本自报的 signatures_hit(result.json),与 Runtime 侧确定性匹配结果并列,供 Analyzer 交叉核对"
    },
    "signatures": {
      "type": "array",
      "description": "Manifest failure_signatures 的 Runtime 侧确定性匹配结果(按声明序)",
      "items": {
        "type": "object",
        "required": ["id", "where", "classify", "matched", "matches"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "where": { "enum": ["logcat", "stdout", "stderr", "logs"] },
          "classify": { "enum": ["INFRA", "BUILD", "CODE", "MODEL", "DELEGATE", "DEVICE", "PERF", "UNKNOWN"] },
          "matched": { "type": "boolean" },
          "matches": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["line_no", "context"],
              "properties": {
                "line_no": { "type": "integer", "minimum": 1 },
                "context": {
                  "type": "string",
                  "description": "命中行 ±50 行上下文;超长单行会裁剪展示"
                },
                "truncated": { "type": "boolean", "default": false }
              }
            },
            "default": []
          },
          "error": {
            "type": "string",
            "description": "降级记录:正则编译失败、对应日志缺失等;不为空时 matched 语义不可用"
          }
        }
      },
      "default": []
    },
    "junit_failures": {
      "type": "array",
      "description": "junit.xml 的 failure/error 用例(最多 20 条,message 截断)",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "classname": { "type": "string" },
          "message": { "type": "string" }
        }
      },
      "default": []
    },
    "metrics": {
      "type": "object",
      "additionalProperties": { "type": "number" },
      "description": "原始指标快照(来自 result.json)"
    },
    "metrics_baseline": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["value"],
        "properties": {
          "value":     { "type": "number" },
          "baseline":  { "type": "number" },
          "delta":     { "type": "number" },
          "delta_pct": { "type": "number" },
          "sample_n":  { "type": "integer", "minimum": 0 }
        }
      },
      "description": "每条指标与历史 PASSED 中位数基线的差值;基线不足(< 3 样本)时 baseline/delta 为 null"
    },
    "inputs": {
      "type": "object",
      "required": ["attachments", "missing"],
      "properties": {
        "attachments": {
          "type": "array",
          "description": "实际参与提取的附件",
          "items": {
            "type": "object",
            "required": ["name", "object_key"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "object_key": { "type": "string", "minLength": 1 },
              "size": { "type": "integer", "minimum": 0 }
            }
          },
          "default": []
        },
        "missing": {
          "type": "array",
          "description": "期望但未上传的证据文件名(junit 缺失、崩溃恢复空附件等,降级而非错误)",
          "items": { "type": "string" },
          "default": []
        },
        "truncated_files": {
          "type": "array",
          "description": "提取过程中因超长单行发生扫描截断的文件;普通大文件会完整扫描,不进入此列表",
          "items": { "type": "string" },
          "default": []
        }
      }
    },
    "truncated": {
      "type": "boolean",
      "default": false,
      "description": "提取发生降级:签名上下文与兜底摘录的共享内容预算耗尽、日志读取错误或不完整、或单行超过 1MiB 扫描上限而发生扫描截断"
    },
    "excerpts": {
      "type": "array",
      "description": "兜底摘录(v2 新增):全部签名未命中时给出有界原文——stdout/stderr 尾部 + logcat 错误行,总量受签名上下文同一 96KB 预算约束,不是全量灌入;否则 Analyzer 只见文件元数据,无法分析",
      "items": {
        "type": "object",
        "required": ["file", "kind", "content"],
        "properties": {
          "file": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["tail", "error_lines"] },
          "content": { "type": "string" },
          "truncated": { "type": "boolean", "default": false }
        }
      },
      "default": []
    }
  }
}
