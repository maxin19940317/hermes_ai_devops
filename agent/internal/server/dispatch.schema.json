{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dispatch.schema.json",
  "title": "TaskDispatchRequest",
  "description": "由 contracts/client-agent-api.openapi.yaml 的 TaskDispatchRequest 组件忠实派生;一致性由 TestEmbeddedSchemaMatchesContract 防漂移。",
  "type": "object",
  "required": [
    "task_id",
    "idempotency_key",
    "attempt",
    "artifact",
    "manifest_digest",
    "device_serial",
    "callback_base_url"
  ],
  "properties": {
    "task_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "{workflow_id}:{task_id}:{attempt},跨组件幂等的唯一依据"
    },
    "attempt": { "type": "integer", "minimum": 1 },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256", "auth"],
      "properties": {
        "url": { "type": "string", "format": "uri", "description": "GitLab Generic Registry 确定性 URL" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "整包校验和,下载后必须校验" },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "enum": ["bearer", "job_token", "basic", "none"] },
            "token": {
              "type": "string",
              "minLength": 1,
              "description": "凭据;type=none(2026-08-14,匿名下载 MinIO 公开桶等)时可省略或为空,其余类型必填。"
            },
            "username": {
              "type": "string",
              "description": "basic(GitLab Deploy Token,原则 5 只读凭据)的 HTTP Basic 用户名;type=basic 时必填(运行时校验),其余类型忽略。"
            }
          },
          "allOf": [
            {
              "if": {
                "not": {
                  "properties": { "type": { "const": "none" } }
                }
              },
              "then": { "required": ["token"] }
            }
          ]
        }
      }
    },
    "manifest_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "包内 manifest.yaml 的 sha256,Client 解包后核对,防止包被替换"
    },
    "device_serial": { "type": "string", "minLength": 1 },
    "callback_base_url": { "type": "string", "format": "uri" },
    "lease_id": {
      "type": "string",
      "description": "租约所有权凭据(目标设计基线 v1.0 §10):Client 心跳续租时必须原样回传,失配即 LEASE_NOT_OWNED。只加字段不删字段,旧 Client 可暂不消费(过渡期心跳不续租)。"
    },
    "lease_generation": {
      "type": "integer",
      "minimum": 1,
      "description": "租约代数,与 lease_id 配对使用(同上)"
    },
    "upload_request_url": {
      "type": "string",
      "description": "按需签发端点的完整 URL(差距 #8),形如 {callback_base_url}/callbacks/v1/upload-requests。Agent 收集完成后用它换取本次实际收集到的文件的预签名 PUT URL。为空 = Runtime 未启用按需签发,Agent 沿用 presigned_uploads[]。"
    },
    "presigned_uploads": {
      "type": "array",
      "default": [],
      "description": "MinIO 预签名上传地址,附件直传不经 Runtime(红线 §14)",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["object_key", "url"],
        "properties": {
          "object_key": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "expires_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
