{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes-devops/contracts/express.schema.json",
  "title": "express v1",
  "description": "飞书指令回答表述层(Express)的 LLM 输出契约(设计文档 2026-08-07-feishu-smart-reply-design.md §4.4)。事实永远由规则计算,LLM 只负责表述与洞察;输出是封闭结构 summary/sections/footer,无自由字段,防止 LLM 编造事实或注入格式。",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "sections", "footer"],
  "properties": {
    "summary": { "type": "string", "minLength": 1, "maxLength": 200 },
    "sections": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 500 },
      "minItems": 1,
      "maxItems": 6
    },
    "footer": { "type": "string", "maxLength": 200 }
  }
}
